{
  // Cloudflare の設定ファイル（サイト本体は public フォルダ）
  "name": "homepage",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "daishinkogyo-warabi.com", "custom_domain": true },
    { "pattern": "www.daishinkogyo-warabi.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
